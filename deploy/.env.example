# Copy to .env *in this directory* and fill in. .env is git-ignored; this file is not (N-40).
#
# It lives beside compose.yaml on purpose. Compose reads `.env` from the compose file's own
# directory for variable interpolation, so an env file at the repository root would quietly
# reach the containers while leaving ${POSTGRES_PASSWORD} in this file unsubstituted.

# The password for the owner role that PostgreSQL is created with. The restricted
# application role and its own password arrive with migration 0001 in T1.4.
POSTGRES_PASSWORD=change-me

# Hostname Caddy issues a certificate for. Leave as localhost for a laptop.
WATCHER_DOMAIN=localhost

# The application role: no UPDATE or DELETE on the append-only tables (D-12).
DATABASE_URL=postgres://watcher_app:change-me@postgres/the_watcher
# The owner role: used by migrations and nothing else.
MIGRATE_DATABASE_URL=postgres://watcher_owner:change-me@postgres/the_watcher

MODEL_PROVIDER=anthropic
MODEL_NAME=
MODEL_BASE_URL=https://api.anthropic.com
MODEL_API_KEY=

PRICE_SOURCE=free
NEWS_SOURCE=none

# N-30, enforced before a run starts rather than after it finishes (N-34).
DAILY_COST_CAP_CENTS=50
# F-53.
CHAT_CAP_PER_DAY=50

# C-19. Both to be revisited once there is real data.
HALF_SPREAD_BPS=5
FEE_CENTS=100
# C-20. A starting value chosen to be revised.
ANNOTATION_WARN_PCT=25
